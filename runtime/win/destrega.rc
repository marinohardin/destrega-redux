/* Windows resources: application manifest (UTF-8 code page, Common Controls 6; see
 * destrega.manifest), the icon (destrega.ico, original art from tools/make_ico.py) and the
 * version information. destrega_version.h is generated by tools/version.py at build time. */
#include <winver.h>
#include "destrega_version.h"

1 24 "destrega.manifest"
1 ICON "destrega.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DESTREGA_VER_NUMS
 PRODUCTVERSION DESTREGA_VER_NUMS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "ProductName", "Destrega (static recompilation)"
            VALUE "FileDescription", "Destrega - native runtime for the recompiled PlayStation game"
            VALUE "ProductVersion", DESTREGA_VER_STR
            VALUE "FileVersion", DESTREGA_VER_STR
            VALUE "InternalName", "destrega"
            VALUE "OriginalFilename", "destrega.exe"
            VALUE "LegalCopyright", "Runtime: Destrega Redux contributors. Destrega is (c) 1998 KOEI Co., Ltd.; no game data is included."
            VALUE "Comments", "Bring your own disc image. Third-party licences: THIRD_PARTY_LICENSES.txt"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
